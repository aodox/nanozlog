.{
    .name = .nanozlog,
    .version = "0.1.0",
    .dependencies = .{
        // Path-pinned under vendor/ (git submodule). Avoid zig fetch remote URLs
        // so builds work without pulling GitHub tarballs (e.g. behind GFW).
        .zeit = .{
            .path = "vendor/zeit",
        },
    },
    .minimum_zig_version = "0.17.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
        "LICENSE.txt",
        "README.md",
    },
    .fingerprint = 0xd0e255281f5d4be5,
}
